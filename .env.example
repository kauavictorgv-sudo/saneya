# Configure estes valores no ambiente da Vercel. Nunca use NEXT_PUBLIC_ para segredos.
# Habilite somente após configurar Resend, remetente e Firewall e testar a entrega.
CONTACT_FORM_ENABLED=false
RESEND_API_KEY=

# Remetente autorizado no Resend, no formato Saneyá Ambiental <endereço autorizado>.
# Não use o e-mail do visitante como remetente. Ele é usado somente em Reply-To.
CONTACT_EMAIL_FROM=

# Origem HTTPS exata do site, sem caminho. Para previews, VERCEL_URL é usado se vazio.
# O acesso local em localhost/127.0.0.1 é aceito quando não há origem configurada.
CONTACT_FORM_ORIGIN=
